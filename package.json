{
  "name": "whisper-app",
  "version": "0.0.1",
  "description": "Whisper is a PWA chat application that allows users to communicate in real-time using a peer-to-peer network. It is built using the Quasar Framework and Vue.js, and it leverages the Trystero library for peer-to-peer communication.",
  "productName": "Whisper",
  "author": "Luiz-Trindade <luiz.gabriel.m.trindade@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "lint:check": "prettier \"**/*.{js,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "dev": "quasar dev",
    "build": "quasar build -m pwa",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "localforage": "^1.10.0",
    "pinia": "^4.0.2",
    "quasar": "^2.35.2",
    "trystero": "^0.26.0",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "prettier": "^3.8.1",
    "@quasar/app-vite": "^3.10.3",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}